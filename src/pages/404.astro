---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección.">
  <section class="page-head">
    <div class="container">
      <p class="prompt">roger@backend:~$ <span>cd pagina-solicitada</span></p>
      <p class="eyebrow">Error 404</p>
      <h1 class="title">Página no encontrada</h1>
      <p class="lead">La página que buscas no existe o cambió de dirección.</p>
      <div class="cta">
        <a class="btn primary" href="/">Volver al inicio</a>
        <a class="btn ghost" href="/blog/">Ir al blog</a>
      </div>
    </div>
  </section>
</Base>
